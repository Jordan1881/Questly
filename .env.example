# ─── Database (direct connection params) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=questly_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_TEST_NAME=questly_test

# ─── Database (production URL — Railway injects this automatically) ──────────
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Frontend URL (for CORS) ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Jira Cloud (also add as Cursor Cloud Agent secrets — see AGENTS.md) ─────
JIRA_SITE_URL=https://yourteam.atlassian.net
JIRA_PROJECT_KEY=QUEST
JIRA_ADMIN_EMAIL=admin@example.com
JIRA_ADMIN_API_TOKEN=
JIRA_DEVELOPER_EMAIL=developer@example.com
JIRA_DEVELOPER_API_TOKEN=
JIRA_DEVELOPER_ACCOUNT_ID=
# Alias used in some env setups (same as JIRA_DEVELOPER_ACCOUNT_ID):
JIRA_ACCOUNT_ID=
# Optional override if auto-detection does not find your story points field:
JIRA_STORY_POINTS_FIELD_ID=

# ─── Atlassian OAuth 3LO (developer Jira connect — see issue #172) ───────────
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Must match Callback URL in Atlassian Developer Console exactly:
ATLASSIAN_OAUTH_CALLBACK_URL=https://your-api.up.railway.app/api/auth/jira/oauth/callback
# Optional — used to derive callback URL when ATLASSIAN_OAUTH_CALLBACK_URL is unset:
API_PUBLIC_URL=https://your-api.up.railway.app
