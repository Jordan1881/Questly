# ─── Database (direct connection params) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=questly_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_TEST_NAME=questly_test

# ─── Database (production URL — Railway injects this automatically) ──────────
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Frontend URL (for CORS) ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
