# Questly environment template — REQUIRED for onboarding.
# Copy to server/.env:  cp .env.example server/.env
# Never commit server/.env (secrets). See DEPLOY.md for production vars.

# ─── Database (direct connection params) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=questly_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_TEST_NAME=questly_test

# ─── Database (production URL — Railway injects this automatically) ──────────
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Multi-workspace membership reads (expand dual-path). Default off — keep unset/false in production until T3+.
MULTI_WORKSPACE=false
# Behind Cloudflare + Railway in production — set TRUST_PROXY_HOPS=2 on Railway (see DEPLOY.md)
TRUST_PROXY_HOPS=
# Optional auth rate-limit overrides (defaults: login 10/15min, register 5/hour)
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_REGISTER_MAX=
RATE_LIMIT_JIRA_CONNECT_MAX=

# ─── Logging (pino structured logs) ──────────────────────────────────────────
# Level: fatal|error|warn|info|debug|trace|silent. Defaults: debug (dev), info (prod), silent (test).
LOG_LEVEL=

# ─── Frontend URL (for CORS) ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# Set true for local dev without per-workspace Jira connect (tests always enable fallback):
JIRA_FALLBACK_ENABLED=

# ─── Jira Cloud (dev/CI fallback only — production uses workspace DB config) ─
JIRA_SITE_URL=https://yourteam.atlassian.net
JIRA_PROJECT_KEY=QUEST
JIRA_ADMIN_EMAIL=admin@example.com
JIRA_ADMIN_API_TOKEN=
JIRA_DEVELOPER_EMAIL=developer@example.com
JIRA_DEVELOPER_API_TOKEN=
JIRA_DEVELOPER_ACCOUNT_ID=
# Alias used in some env setups (same as JIRA_DEVELOPER_ACCOUNT_ID):
JIRA_ACCOUNT_ID=
# Optional override if auto-detection does not find your story points field:
JIRA_STORY_POINTS_FIELD_ID=
# Reliability knobs for outbound Jira calls (sane defaults applied when unset):
JIRA_REQUEST_TIMEOUT_MS=10000
JIRA_MAX_RETRIES=2
JIRA_PAGE_SIZE=100
# Cache TTL (ms) for Jira field discovery; 0 disables. Ignored under test.
JIRA_FIELD_CACHE_TTL_MS=300000

# ─── Jira token encryption at rest (production — T159) ───────────────────────
# 32+ char random string; when set, workspace + user Jira tokens are AES-256-GCM encrypted in Postgres.
JIRA_TOKEN_ENCRYPTION_KEY=

# ─── Atlassian OAuth 3LO (developer Jira connect — see issue #172) ───────────
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Must match Callback URL in Atlassian Developer Console exactly:
ATLASSIAN_OAUTH_CALLBACK_URL=https://your-api.up.railway.app/api/auth/jira/oauth/callback
# Workspace admin Jira sync OAuth callback (T156):
ATLASSIAN_WORKSPACE_OAUTH_CALLBACK_URL=https://your-api.up.railway.app/api/workspaces/jira/oauth/callback
# Optional — used to derive callback URLs when ATLASSIAN_*_CALLBACK_URL is unset:
API_PUBLIC_URL=https://your-api.up.railway.app
# App owner's OAuth refresh token for Atlassian Personal Data Reporting API (see DEPLOY.md):
ATLASSIAN_REPORTING_REFRESH_TOKEN=

# ─── Avatar storage (profile photo uploads) ───────────────────────────────────
# local = dev default (files in server/uploads/, served by API)
# s3    = production (AWS S3)
AVATAR_STORAGE=local
S3_BUCKET=questly-avatars
S3_REGION=us-east-1
# Leave unset for AWS S3. Only needed for S3-compatible providers (MinIO, R2).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for avatars (bucket URL or CloudFront), no trailing slash
S3_PUBLIC_URL=https://questly-avatars.s3.us-east-1.amazonaws.com
